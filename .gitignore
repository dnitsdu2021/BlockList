# ==============================================================================
# .gitignore for Blacklist IP Manager
# (Python dev server + Cloudflare Worker + Web UI + Excel imports/exports)
# ==============================================================================

# 1. Environment Secrets & Tokens
.env
.env.*
!.env.example
*.pem
*.key

# 2. Cloudflare Wrangler & Node.js
# Local state, build caches, and dev secrets created by Wrangler
.wrangler/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/

# 4. Dev Server Logs & Temp Files
*.log
*.tmp
*.bak

# 5. Local Excel Downloads & Test Uploads
# Prevents downloaded export files (e.g. blacklist-ips-2026-10-23.xlsx)
# or ad-hoc test sheets from cluttering git history
blacklist-ips-*.xlsx
test-*.xlsx
test-*.csv

# 6. IDEs & Editors
.vscode/*-profile/
.vscode/*-profile
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 7. Operating System Artifacts
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
